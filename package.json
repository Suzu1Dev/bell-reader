{
  "name": "bell-reader",
  "version": "1.0.0",
  "description": "Local-first web article snapshot & organic ink annotation reader — standalone or part of BELL Suite.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suzu1Dev/bell-reader.git"
  },
  "homepage": "https://github.com/Suzu1Dev/bell-reader#readme",
  "bin": {
    "bell-reader": "./bin/bell-reader.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "shared",
    "LICENSE",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "prepare": "node -e \"import('node:fs').then(fs=>{if(fs.existsSync('node_modules/vite')&&!fs.existsSync('dist/index.html'))import('node:child_process').then(cp=>cp.execSync('npm run build',{stdio:'inherit'}))})\"",
    "prepack": "npm run build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "BELL_LOG=off tsx --test --test-timeout=60000 server/*.test.ts src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "cheerio": "^1.1.2",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.13.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "1.1.1",
    "concurrently": "^9.2.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
