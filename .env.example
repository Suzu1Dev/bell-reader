# BELL Web Reader 設定範例
PORT=21104
HOST=127.0.0.1
BELL_READER_DATA_DIR=./data

# 瀏覽器切換器與交接目標（逗號分隔 appId=origin）
BELL_READER_SUITE_LINKS=personal=http://127.0.0.1:21103,explain=http://127.0.0.1:21101

# 伺服器讀取 BELL Explain 主題筆記（僅接受 IP 字面值 loopback）
BELL_READER_SUITE_FETCH=explain=http://127.0.0.1:21101

# 選用：非 loopback Tailscale HTTPS 允許來源
# BELL_READER_ALLOWED_ORIGINS=https://host.tailnet.ts.net:20004

# 選用：OpenAI 相容 API（未設定時預設使用本機 Claude / Codex CLI）
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
